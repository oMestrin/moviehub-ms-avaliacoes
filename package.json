{
  "name": "moviehub-ms-avaliacoes",
  "version": "1.0.0",
  "private": true,
  "description": "MovieHub — microsserviço de avaliações (Azure SQL + eventos na fila do Azure Storage), Clean Architecture + Vertical Slice",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "dev": "node --watch src/main.js",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\"",
    "test:unit": "node --test --test-reporter=spec \"test/unit/*.test.js\" \"test/api/*.test.js\"",
    "test:arch": "node --test --test-reporter=spec \"test/architecture/*.test.js\"",
    "test:integration": "node --test --test-reporter=spec \"test/integration/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@azure/storage-queue": "^12.32.0",
    "express": "^5.3.0",
    "mssql": "^11.0.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "archunit": "^2.5.4",
    "azurite": "^3.37.0",
    "typescript": "^5.9.3"
  }
}
