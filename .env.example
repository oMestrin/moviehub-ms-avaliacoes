PORT=3002
# Connection string ADO.NET do Azure SQL. Vazia = repositório em memória.
# Ex.: Server=tcp:<servidor>.database.windows.net,1433;Database=moviehub-avaliacoes;User ID=<usuario>;Password=<senha>;Encrypt=true;
SQL_CONNECTION_STRING=
# Connection string do Storage Account (fila de eventos). Vazia = eventos só no log.
# Local com Azurite: UseDevelopmentStorage=true
STORAGE_CONNECTION_STRING=
EVENTS_QUEUE_NAME=avaliacoes-eventos
SEED_ON_START=true
